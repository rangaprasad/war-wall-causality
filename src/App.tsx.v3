import React, { useEffect, useMemo, useRef, useState } from "react";
import { WAR_COLLEGE_LESSONS } from "./companion/chapters-war-college";
import type { Lesson, AutoStep } from "./companion/chapters-war-college";
import { TrainingPanel, SCENARIOS } from "./training/GuidedTraining";


/* =========================================================
   PearlKit — WAR-Wall S→T→I (Chapters + Study Companion)
   Left: Controls + Metrics + Tiny Chart
   Right: DAG viewer + Identifiability + Transport + Policy + Study Companion
   ========================================================= */

type Row = { W:number; M:number; S:number; T:number; I:0|1; epsS:number; epsT:number; };

const clamp01 = (x:number)=>Math.max(0,Math.min(1,x));
const rnd = ()=>Math.random();
const avg = (xs:number[])=>xs.reduce((s,v)=>s+v,0)/(xs.length||1);
const bin = (v:number,thr=0.5)=> (v>=thr?1:0);
const S_high = (S:number)=> (S>=0.6?1:0);

/* ---------- Structural parameters (editable via sliders) ---------- */
type Params = {
  // S = baseS - aW*W - aM*(1-M) + nS
  baseS:number; aW:number; aM:number; nS:number;
  // T = baseT + bS*S + nT
  baseT:number; bS:number; nT:number;
  // I = step(T - cW*W > thrT)
  cW:number; thrT:number;
};

const DEFAULT: Params = {
  baseS:0.75, aW:0.45, aM:0.25, nS:0.15,
  baseT:0.15, bS:0.85, nT:0.10,
  cW:0.12, thrT:0.60
};

/* ---------- SCM ---------- */
function fS(W:number,M:number,epsS:number,P:Params){
  const s = P.baseS - P.aW*W - P.aM*(1-M) + P.nS*epsS;
  return clamp01(s);
}
function gT(S:number,epsT:number,P:Params){
  const t = P.baseT + P.bS*S + P.nT*epsT;
  return clamp01(t);
}
function hI(T:number,W:number,P:Params){
  const z = T - P.cW*W;
  return z > P.thrT ? 1 : 0;
}
function unitNoise(){ return rnd()+rnd()-1; }

/* ---------- Data ---------- */
function simulateDataset(N:number, W_mean:number, M_mean:number, P:Params): Row[] {
  const rows:Row[] = [];
  for(let i=0;i<N;i++){
    const Wi = clamp01(W_mean + 0.20*(rnd()+rnd()-1));
    const Mi = clamp01(M_mean + 0.20*(rnd()+rnd()-1));
    const epsS = unitNoise(); const epsT = unitNoise();
    const S = fS(Wi,Mi,epsS,P);
    const T = gT(S,epsT,P);
    const I = hI(T,Wi,P) as 0|1;
    rows.push({W:Wi,M:Mi,S,T,I,epsS,epsT});
  }
  return rows;
}

/* ---------- Back-door ATE for X=S_high on I, adjust Z={W_bin,M_bin} ---------- */
function ateBackDoor(rows:Row[]){
  const groups:Record<string,Row[]> = {};
  for(const r of rows){ const z=`W${bin(r.W)}_M${bin(r.M)}`; (groups[z] ||= []).push(r); }
  let ate=0;
  for(const grp of Object.values(groups)){
    if(grp.length<4) continue;
    const x1=grp.filter(r=>S_high(r.S)===1), x0=grp.filter(r=>S_high(r.S)===0);
    if(x1.length<2||x0.length<2) continue;
    const Ey1=avg(x1.map(r=>r.I)), Ey0=avg(x0.map(r=>r.I)), pz=grp.length/rows.length;
    ate += (Ey1-Ey0)*pz;
  }
  return ate;
}

/* ---------- Counterfactuals ---------- */
function counterfactual_I(row:Row, forcedS:number, P:Params){
  const S = clamp01(forcedS);
  const T = gT(S,row.epsT,P);
  return hI(T,row.W,P) as 0|1;
}
function PN(rows:Row[],P:Params){
  const losers = rows.filter(r=>r.I===0); if(!losers.length) return 0;
  const flips = losers.filter(r=>counterfactual_I(r,0.9,P)===1).length;
  return flips/losers.length;
}
function PS(rows:Row[],P:Params){
  const lowLost = rows.filter(r=>r.I===0 && S_high(r.S)===0); if(!lowLost.length) return 0;
  const flips = lowLost.filter(r=>counterfactual_I(r,0.9,P)===1).length;
  return flips/lowLost.length;
}
function PNS(pn:number,ps:number){ return pn*ps; }

/* ---------- Transport: use A’s conditionals with B’s P(z) ---------- */
function ateTransport(A:Row[], B:Row[]){
  // Estimate E[I|X,z] from A; weight by P_B(z)
  const Az:Record<string,{x1:number;x0:number;n1:number;n0:number;}> = {};
  const countB:Record<string,number> = {};
  for(const r of A){
    const z=`W${bin(r.W)}_M${bin(r.M)}`;
    const bucket = (Az[z] ||= {x1:0,x0:0,n1:0,n0:0});
    if(S_high(r.S)){ bucket.x1 += r.I; bucket.n1++; } else { bucket.x0 += r.I; bucket.n0++; }
  }
  for(const r of B){ const z=`W${bin(r.W)}_M${bin(r.M)}`; countB[z]=(countB[z]||0)+1; }
  const totalB = B.length || 1;
  let ate=0;
  for(const [z,b] of Object.entries(Az)){
    const pzB = (countB[z]||0)/totalB;
    if(b.n1>1 && b.n0>1){
      const Ey1=b.x1/b.n1, Ey0=b.x0/b.n0;
      ate += (Ey1-Ey0)*pzB;
    }
  }
  return ate;
}

/* ---------- Policy: allocate supply boosts to top uplift units under budget ---------- */
function policyUpliftExpectedWin(rows:Row[], budgetFrac:number, P:Params){
  const gains = rows.map(r=>{
    const base = r.I;
    const cf = counterfactual_I(r,0.9,P);
    return {gain: cf - base, base};
  }).sort((a,b)=> b.gain - a.gain);
  const K = Math.floor(rows.length * clamp01(budgetFrac));
  let wins=0;
  for(let i=0;i<rows.length;i++){
    if(i<K) wins += (gains[i].base===1?1: (gains[i].gain>0?1:0));
    else wins += gains[i].base;
  }
  return 100*wins/rows.length;
}

/* ---------- Tiny canvas line chart ---------- */
function TinyChart({ data }:{data:number[]}) {
  const ref = useRef<HTMLCanvasElement|null>(null);
  useEffect(()=>{
    const c=ref.current; if(!c) return; const ctx=c.getContext("2d"); if(!ctx) return;
    const W=c.width, H=c.height, pad=8;
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle="rgba(255,255,255,0.02)"; ctx.fillRect(0,0,W,H);
    ctx.strokeStyle="#2a2a2a"; ctx.strokeRect(0.5,0.5,W-1,H-1);
    if(data.length<2) return;
    const step=(W-2*pad)/(data.length-1);
    ctx.strokeStyle="rgba(165,180,252,1)"; ctx.lineWidth=2; ctx.beginPath();
    data.forEach((v,i)=>{
      const x=pad+i*step; const y=pad+(H-2*pad)*(1 - v/100);
      if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    });
    ctx.stroke();
  },[data]);
  return <canvas ref={ref} width={520} height={160} style={{width:"100%",height:160}}/>;
}

/* ---------- Right-panel DAG canvas ---------- */

function DagCanvas({
  P,
  backdoorOK,
  frontdoorOK
}: {
  P: any;
  backdoorOK?: boolean;
  frontdoorOK?: boolean;
}) {
  const ref = useRef<HTMLCanvasElement | null>(null);
  const rafRef = useRef<number | null>(null);

  useEffect(() => {
    const c = ref.current;
    if (!c) return;
    const g = c.getContext("2d");
    if (!g) return;

    // Fixed node layout
    const nodes = {
      W: { x: 120, y: 80,  label: "Weather (W)" },
      M: { x: 120, y: 220, label: "Morale (M)" },
      S: { x: 320, y: 150, label: "Supply (S)" },
      T: { x: 520, y: 150, label: "Tempo (T)" },
      I: { x: 720, y: 150, label: "Initiative (I)" }
    };

    const lerp = (a:number,b:number,t:number)=>a+(b-a)*t;
    const edgeWidth = (coef:number,min=1.5,max=5)=> lerp(min,max,Math.max(0,Math.min(1,coef)));

    const drawNode = (n:any) => {
      g.fillStyle = "rgba(255,255,255,0.05)";
      g.strokeStyle = "#2a2a2a";
      g.lineWidth = 1.5;
      g.beginPath();
      (g as any).roundRect?.(n.x - 70, n.y - 24, 140, 48, 10);
      if (!(g as any).roundRect) g.rect(n.x - 70, n.y - 24, 140, 48);
      g.fill();
      g.stroke();
      g.fillStyle = "#eaeaea";
      g.font = "14px Inter, ui-sans-serif";
      g.textAlign = "center";
      g.textBaseline = "middle";
      g.fillText(n.label, n.x, n.y);
    };

    const arrowVar = (a:any,b:any,w:number,color:string,dashed=false, dashOffset=0)=>{
      g.save();
      g.strokeStyle = color;
      g.lineWidth = w;
      if (dashed) { g.setLineDash([8,6]); g.lineDashOffset = dashOffset; }
      g.beginPath(); g.moveTo(a.x+70,a.y); g.lineTo(b.x-70,b.y); g.stroke();
      const ang = Math.atan2(b.y-a.y, b.x-a.x);
      const hx = b.x-70, hy = b.y;
      g.beginPath();
      g.moveTo(hx,hy);
      g.lineTo(hx-10*Math.cos(ang-Math.PI/6), hy-10*Math.sin(ang-Math.PI/6));
      g.lineTo(hx-10*Math.cos(ang+Math.PI/6), hy-10*Math.sin(ang+Math.PI/6));
      g.closePath(); g.fillStyle = color; g.fill();
      g.restore();
    };

    const halo = (n:any, baseColor:[number,number,number], t:number, grow=0)=>{
      // Breathing pulse: alpha 0.10→0.28, radius 62→74 (slight)
      const alpha = 0.19 + 0.09 * (0.5 + 0.5 * Math.sin(t));
      const radius = 68 + grow * (0.5 + 0.5 * Math.sin(t));
      const [r,gc,b] = baseColor;
      const grad = g.createRadialGradient(n.x, n.y, 4, n.x, n.y, radius);
      grad.addColorStop(0, `rgba(${r},${gc},${b},${alpha})`);
      grad.addColorStop(1, `rgba(${r},${gc},${b},0)`);
      g.fillStyle = grad;
      g.beginPath();
      g.arc(n.x, n.y, radius, 0, Math.PI*2);
      g.fill();
    };

    const render = (timeMs:number)=>{
      const Wc = c.width, Hc = c.height;
      g.clearRect(0,0,Wc,Hc);

      // Time terms
      const t = timeMs * 0.004;          // halo pulse speed
      const dashT = -timeMs * 0.05;      // dashed edge scroll

      // Halos (teaching cues)
      if (backdoorOK) {
        halo(nodes.W, [46,204,113], t, 6);
        halo(nodes.M, [46,204,113], t, 6);
      }
      if (frontdoorOK) {
        halo(nodes.T, [236,72,153], t+Math.PI/3, 8);
      }

      // Nodes behind edges (soft layering)
      drawNode(nodes.W); drawNode(nodes.M); drawNode(nodes.S); drawNode(nodes.T); drawNode(nodes.I);

      // Live edge thickness
      const w_WS = edgeWidth(P.aW);
      const w_MS = edgeWidth(P.aM);
      const w_ST = edgeWidth(P.bS);
      const w_TI = 2.4;
      const w_WI = edgeWidth(P.cW);

      // Edges (orange dashed shimmers)
      arrowVar(nodes.W, nodes.S, w_WS, "#60a5fa");
      arrowVar(nodes.M, nodes.S, w_MS, "#60a5fa");
      arrowVar(nodes.S, nodes.T, w_ST, "#a1a1aa");
      arrowVar(nodes.T, nodes.I, w_TI, "#a1a1aa");
      if (P.cW > 0) arrowVar(nodes.W, nodes.I, w_WI, "#f59e0b", true, dashT);

      // Top pass for crisp labels
      drawNode(nodes.W); drawNode(nodes.M); drawNode(nodes.S); drawNode(nodes.T); drawNode(nodes.I);

      rafRef.current = requestAnimationFrame(render);
    };

    rafRef.current = requestAnimationFrame(render);
    return () => { if (rafRef.current) cancelAnimationFrame(rafRef.current); };
  }, [P, backdoorOK, frontdoorOK]);

  return <canvas ref={ref} width={840} height={320} style={{ width:"100%", height:320, display:"block" }}/>;
}

/* ---------- Identifiability badges ---------- */
function identifiability(P:Params){
  const backdoorOK = true;
  const frontdoorOK = (P.cW===0);
  return { backdoorOK, frontdoorOK, nonIdentifiable: !(backdoorOK || frontdoorOK) };
}

/* ========================= UI ========================= */
export default function App(){
  // Theater toggles (C): A and B
  const [theater, setTheater] = useState<'A'|'B'>('A');
  const [WB, setWB] = useState(0.55);
  const [MB, setMB] = useState(0.45);

  const [N, setN] = useState(1000);
  const [W, setW] = useState(0.35);
  const [M, setM] = useState(0.65);
  const [P, setP] = useState<Params>(DEFAULT);

  const [auto, setAuto] = useState(false);
  const [series, setSeries] = useState<number[]>([]);
  const [budget, setBudget] = useState(0.15);

  const [trainingOpen, setTrainingOpen] = useState(false);
  const [scenarioIdx, setScenarioIdx] = useState(0);
  const [stepIdx, setStepIdx] = useState(0);

  const curScenario = SCENARIOS[scenarioIdx];
  const curStep = curScenario.steps[stepIdx];

  // (optional) drive DAG halos from lesson emphasis
  const haloBackdoor = !!curStep?.emphasis?.backdoorOK;
  const haloFrontdoor = !!curStep?.emphasis?.frontdoorOK;

<button onClick={()=>{ setTrainingOpen(true); setScenarioIdx(0); setStepIdx(0); }}>
  Guided Training
</button>

<TrainingPanel
  open={trainingOpen}
  scenarioIdx={scenarioIdx}
  stepIdx={stepIdx}
  onClose={()=> setTrainingOpen(false)}
  onPrev={()=> setStepIdx(s => Math.max(0, s-1))}
  onNext={()=> setStepIdx(s => Math.min((curScenario.steps.length-1), s+1))}
  onPickScenario={(i)=> { setScenarioIdx(i); setStepIdx(0); }}
/>


  // NEW: Study companion state & auto-runner
  const [lesson, setLesson] = useState<Lesson>(WAR_COLLEGE_LESSONS[0]);
  const [autoRunning, setAutoRunning] = useState(false);
  const sleep = (ms:number)=>new Promise(res=>setTimeout(res,ms));
  async function runLessonAuto(steps: AutoStep[]){
    if(autoRunning) return;
    setAutoRunning(true);
    try{
      for(const st of steps){
        if(st.kind==="wait"){ await sleep(st.ms); continue; }
        if(st.kind==="play"){ setAuto(st.value); continue; }
        if(st.kind==="theater"){ setTheater(st.value); continue; }
        if(st.kind==="set"){
          if(st.target==="W") setW(st.value);
          if(st.target==="M") setM(st.value);
          if(st.target==="WB") setWB(st.value);
          if(st.target==="MB") setMB(st.value);
          if(st.target==="budget") setBudget(st.value);
          continue;
        }
        if(st.kind==="param"){ setP(prev=>({...prev,[st.name]:st.value})); continue; }
      }
    } finally {
      setAuto(false);
      setAutoRunning(false);
    }
  }

  // Data per theater
  const dataA = useMemo(()=> simulateDataset(N, W, M, P), [N,W,M,P]);
  const dataB = useMemo(()=> simulateDataset(N, WB, MB, P), [N,WB,MB,P]);

  const active = theater==='A'? dataA : dataB;

  // Metrics on active theater
  const ate  = useMemo(()=> ateBackDoor(active), [active]);
  const pn   = useMemo(()=> PN(active,P), [active,P]);
  const ps   = useMemo(()=> PS(active,P), [active,P]);
  const pns  = useMemo(()=> PNS(pn,ps), [pn,ps]);

  const sMean = avg(active.map(d=>d.S));
  const tMean = avg(active.map(d=>d.T));
  const iRate = 100*avg(active.map(d=>d.I));

  // Transport estimate: A→B
  const ateA = useMemo(()=> ateBackDoor(dataA), [dataA]);
  const ateB = useMemo(()=> ateBackDoor(dataB), [dataB]);
  const ateA_to_B = useMemo(()=> ateTransport(dataA, dataB), [dataA, dataB]);

  // Policy uplift on active theater
  const policyWin = useMemo(()=> policyUpliftExpectedWin(active, budget, P), [active,budget,P]);

  // Autoplay random walk (A theater params W,M only)
  useEffect(()=>{
  if(!auto) return;
  const id = setInterval(()=>{
    if (theater === 'A') {
      setW(w=>clamp01(w+(Math.random()-0.5)*0.06));
      setM(m=>clamp01(m+(Math.random()-0.5)*0.06));
    } else {
      setWB(w=>clamp01(w+(Math.random()-0.5)*0.06));
      setMB(m=>clamp01(m+(Math.random()-0.5)*0.06));
    }
    setSeries(prev=>{
      const next=[...prev,iRate];
      return next.length>120 ? next.slice(-120) : next;
    });
  }, 500);
  return ()=>clearInterval(id);
},[auto,iRate,theater]);

  // push a point on manual change
  useEffect(()=>{
    setSeries(prev=>{ const next=[...prev,iRate]; return next.length>120? next.slice(-120): next; });
  },[W,M,N,theater,iRate]);

  const idBadges = identifiability(P);

  return (
    <div style={st.page}>
      <div style={st.wrap}>
        <div style={st.columns}>
          {/* LEFT PANEL */}
          <div style={st.left}>
            <h1 style={st.h1}>PearlKit — WAR-Wall (S→T→I)</h1>
            <p style={st.muted}>Adjust the theater, structure, and see causal effects play out.</p>

            {/* Theater switch + episode count */}
            <div style={st.grid2}>
              <Card title="Active Theater">
                <div style={{display:"flex",gap:8}}>
                  <button onClick={()=>setTheater('A')} style={btn(theater==='A')}>Theater A</button>
                  <button onClick={()=>setTheater('B')} style={btn(theater==='B')}>Theater B</button>
                </div>
                <Hint>A and B share structure (P) but differ in conditions.</Hint>
              </Card>
              <Card title="Episode Count (N)">
                <Number value={N} on={setN} min={200} max={20000} step={200}/>
                <div style={{display:"flex",gap:8,marginTop:8}}>
                  <button onClick={()=>setAuto(a=>!a)} style={st.button}>{auto?"⏸ Pause":"▶️ Play"}</button>
                  <button onClick={()=>setSeries([])} style={st.button}>🧹 Clear Chart</button>
                </div>
                <Hint>Larger N → smoother estimates</Hint>
              </Card>
            </div>

            {/* Theater A controls */}
            <Card title="Theater A Conditions">
              <Slider label="Weather (W_A)" value={W} set={setW}/>
              <Slider label="Morale (M_A)"  value={M} set={setM}/>
            </Card>

            {/* Theater B controls */}
            <Card title="Theater B Conditions">
              <Slider label="Weather (W_B)" value={WB} set={setWB}/>
              <Slider label="Morale (M_B)"  value={MB} set={setMB}/>
            </Card>

            {/* Metrics */}
            <div style={st.grid2}>
              <Metric label="Avg Supply (S)" value={sMean} fmt="pct"/>
              <Metric label="Avg Tempo (T)"   value={tMean} fmt="pct"/>
              <Metric label="Initiative Success" value={iRate} fmt="pct100"/>
              <Metric label="ATE(S→I) adj. {W,M}" value={ate} fmt="delta"/>
            </div>

            <div style={st.grid3}>
              <Metric big label="PN (necessity)" value={pn} fmt="pct"/>
              <Metric big label="PS (sufficiency)" value={ps} fmt="pct"/>
              <Metric big label="PNS (hinge power)" value={pns} fmt="pct"/>
            </div>

            <div style={{marginTop:12}}>
              <div style={st.subtle}>Initiative Success (%) — last {series.length} ticks</div>
              <TinyChart data={series}/>
            </div>
          </div>

          {/* RIGHT PANEL */}
          <div style={st.right}>
            {/* A: DAG + Identifiability */}
            <Card title="DAG Viewer & Identifiability">
              <DagCanvas P={P} backdoorOK={haloBackdoor} frontdoorOK={haloFrontdoor}/>
              <div style={{display:"flex",gap:8,flexWrap:"wrap"}}>
                <Badge ok={idBadges.backdoorOK} label="Back-door identifiable (adjust {W,M})"/>
                <Badge ok={idBadges.frontdoorOK} label="Front-door identifiable (only if cW=0)"/>
                <Badge ok={!idBadges.nonIdentifiable} label="Non-identifiable? No (here)"/>
              </div>
            </Card>

            {/* B: Structural Equations */}
            <Card title="Structural Equations (live)">
              <Section label="S = base − aW*W − aM*(1−M) + nS*εS">
                <Knob label="base" v={P.baseS} set={(x)=>setP({...P,baseS:x})}/>
                <Knob label="aW"   v={P.aW}    set={(x)=>setP({...P,aW:x})}/>
                <Knob label="aM"   v={P.aM}    set={(x)=>setP({...P,aM:x})}/>
                <Knob label="nS"   v={P.nS}    set={(x)=>setP({...P,nS:x})}/>
              </Section>
              <Section label="T = base + bS*S + nT*εT">
                <Knob label="base" v={P.baseT} set={(x)=>setP({...P,baseT:x})}/>
                <Knob label="bS"   v={P.bS}    set={(x)=>setP({...P,bS:x})}/>
                <Knob label="nT"   v={P.nT}    set={(x)=>setP({...P,nT:x})}/>
              </Section>
              <Section label="I = step(T − cW*W > thr)">
                <Knob label="cW (direct W→I)" v={P.cW}  set={(x)=>setP({...P,cW:x})}/>
                <Knob label="thrT"             v={P.thrT} set={(x)=>setP({...P,thrT:x})}/>
              </Section>
              <div style={{display:"flex",gap:8,marginTop:8}}>
                <button style={st.button} onClick={()=>setP(DEFAULT)}>Reset</button>
              </div>
            </Card>

            {/* C: Transport A→B */}
            <Card title="Transport (A → B)">
              <div style={st.kv}><span>ATE_A (obs):</span><b>{fmtDelta(ateA)}</b></div>
              <div style={st.kv}><span>ATE_B (obs):</span><b>{fmtDelta(ateB)}</b></div>
              <div style={st.kv}><span>ATE_A→B (transport est.):</span><b>{fmtDelta(ateA_to_B)}</b></div>
              <Hint>Transport uses A’s E[I|X,z] but weights by B’s P(z).</Hint>
            </Card>

            {/* D: Commander Policy */}
            <Card title="Commander Policy — Supply Boost Allocation">
              <Slider label="Budget (fraction of units boosted)" value={budget} set={setBudget}/>
              <div style={st.kv}><span>Expected wins under policy:</span><b>{policyWin.toFixed(1)}%</b></div>
              <Hint>Greedy uplift: boost units with highest counterfactual gain I( do(S=high) ) − I.</Hint>
            </Card>

            {/* NEW: Study Companion — manual + auto-guided */}
            <Card title="Study Companion — War College Mode">
              <div style={{ display: "grid", gridTemplateColumns: "1fr", gap: 8 }}>
                <div>
                  <label style={{ fontSize: 12, color: "#9aa0a6" }}>Chapter</label>
                  <select
                    value={lesson.id}
                    onChange={e => {
                      const id = parseInt(e.target.value, 10);
                      const found = WAR_COLLEGE_LESSONS.find(l => l.id === id)!;
                      setLesson(found);
                    }}
                    style={{ width: "100%", padding: "8px 10px", background: "#111113", color: "#eaeaea", border: "1px solid #2a2a2a", borderRadius: 8 }}
                  >
                    {WAR_COLLEGE_LESSONS.map(l => (
                      <option key={l.id} value={l.id}>{l.title}</option>
                    ))}
                  </select>
                </div>

                <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid #2a2a2a", borderRadius: 10, padding: 10 }}>
                  <div style={{ fontWeight: 600, marginBottom: 6 }}>Doctrine</div>
                  <div style={{ color: "#cbd5e1", fontSize: 14 }}>{lesson.doctrine}</div>
                </div>

                <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid #2a2a2a", borderRadius: 10, padding: 10 }}>
                  <div style={{ fontWeight: 600, marginBottom: 6 }}>Manual Orders</div>
                  <ol style={{ marginLeft: 18, color: "#cbd5e1" }}>
                    {lesson.manualOrders.map((s, i) => <li key={i} style={{ marginBottom: 6 }}>{s}</li>)}
                  </ol>
                  <div style={{ fontSize: 12, color: "#9aa0a6" }}>
                    Use the controls to execute these steps yourself.
                  </div>
                </div>

                <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid #2a2a2a", borderRadius: 10, padding: 10 }}>
                  <div style={{ fontWeight: 600, marginBottom: 6 }}>Interpretation</div>
                  <div style={{ color: "#cbd5e1" }}>{lesson.interpretation}</div>
                </div>

                <div style={{ display: "flex", gap: 8 }}>
                  <button
                    disabled={autoRunning}
                    onClick={() => runLessonAuto(lesson.auto)}
                    style={{ ...st.button, opacity: autoRunning ? 0.6 : 1 }}
                  >
                    {autoRunning ? "Running…" : "▶️ Run Lesson (Auto-Guided)"}
                  </button>
                  <button
                    onClick={() => { setAuto(false); setAutoRunning(false); }}
                    style={st.button}
                  >
                    ⏹ Stop
                  </button>
                </div>
              </div>
            </Card>
          </div>
        </div>
      </div>
    </div>
  );
}

/* ---------- small UI helpers ---------- */
function Card({title,children}:{title:string;children:React.ReactNode}){ return <div style={st.card}><div style={st.cardTitle}>{title}</div>{children}</div>; }
function Hint({children}:{children:React.ReactNode}){ return <div style={st.hint}>{children}</div>; }
function Number({value,on,min,max,step}:{value:number;on:(n:number)=>void;min:number;max:number;step:number;}){
  return <input type="number" value={value} min={min} max={max} step={step} onChange={e=>on(parseInt(e.target.value||"1000",10))} style={st.number}/>;
}
function Slider({label,value,set}:{label:string;value:number;set:(v:number)=>void;}){
  return (
    <div style={{marginBottom:8}}>
      <div style={st.sliderRow}><div>{label}</div><div style={st.sliderVal}>{value.toFixed(2)}</div></div>
      <input type="range" min={0} max={1} step={0.01} value={value} onChange={e=>set(parseFloat(e.target.value))} style={{width:"100%"}}/>
    </div>
  );
}
function Metric({label,value,fmt="raw",big=false}:{label:string;value:number;fmt?:"raw"|"pct"|"pct100"|"delta";big?:boolean;}){
  let display=value.toFixed(3);
  if(fmt==="pct") display=`${(value*100).toFixed(1)}%`;
  if(fmt==="pct100") display=`${value.toFixed(1)}%`;
  if(fmt==="delta") display=(value>=0?"+":"")+value.toFixed(3);
  return <div style={st.metric}><div style={st.metricLabel}>{label}</div><div style={{...st.metricValue,fontSize:big?26:18}}>{display}</div></div>;
}
function Section({label,children}:{label:string;children:React.ReactNode}){ return <div style={st.section}><div style={st.sectionLabel}>{label}</div><div style={st.knobs}>{children}</div></div>; }
function Knob({label,v,set}:{label:string;v:number;set:(x:number)=>void;}){
  return <div style={st.knob}>
    <div style={st.knobLabel}>{label}</div>
    <input type="range" min={0} max={1.2} step={0.01} value={v} onChange={e=>set(parseFloat(e.target.value))}/>
    <div style={st.knobVal}>{v.toFixed(2)}</div>
  </div>;
}
function Badge({ok,label}:{ok:boolean;label:string}){ return <span style={{...st.badge,background: ok?"#12321a":"#3a1a1a", borderColor: ok?"#2f9e44":"#b91c1c"}}>{label}</span>; }
const btn = (active:boolean)=> ({...st.button, background: active? "#1b1b1e":"#111113", borderColor: active? "#4b5563":"#2a2a2a"});

const fmtDelta=(x:number)=> (x>=0?"+":"")+x.toFixed(3);

/* ---------- styles ---------- */
const st:Record<string,React.CSSProperties>={
  page:{minHeight:"100vh",background:"#0b0b0c",color:"#eaeaea",padding:"16px 16px 24px 16px"},
  wrap:{ maxWidth:"100vw", margin:0 },
  columns:{ display:"grid", gridTemplateColumns:"minmax(420px,1fr) minmax(820px,2fr)", gap:16 },
  left:{},
  right:{},
  h1:{fontSize:22,fontWeight:700,marginBottom:6},
  muted:{color:"#9aa0a6",marginBottom:12},
  grid2:{display:"grid",gridTemplateColumns:"repeat(2,minmax(0,1fr))",gap:12,marginBottom:12},
  grid3:{display:"grid",gridTemplateColumns:"repeat(3,minmax(0,1fr))",gap:12,marginTop:8},
  card:{border:"1px solid #2a2a2a",borderRadius:14,padding:16,background:"rgba(255,255,255,0.04)",marginBottom:12},
  cardTitle:{fontWeight:600,marginBottom:8},
  hint:{color:"#9aa0a6",fontSize:12,marginTop:6},
  number:{width:"100%",background:"#111113",color:"#eaeaea",border:"1px solid #2a2a2a",borderRadius:8,padding:"8px 10px"},
  button:{background:"#111113",color:"#eaeaea",border:"1px solid #2a2a2a",borderRadius:8,padding:"8px 10px",cursor:"pointer"},
  metric:{border:"1px solid #2a2a2a",borderRadius:14,padding:16,background:"rgba(255,255,255,0.04)"},
  metricLabel:{color:"#9aa0a6",fontSize:11,letterSpacing:0.6,textTransform:"uppercase"},
  metricValue:{marginTop:6,fontWeight:700,fontVariantNumeric:"tabular-nums"},
  subtle:{color:"#9aa0a6",fontSize:12,marginBottom:6},
  sliderRow:{display:"flex",justifyContent:"space-between",marginBottom:4},
  sliderVal:{fontVariantNumeric:"tabular-nums"},
  badge:{display:"inline-block",border:"1px solid",borderRadius:999, padding:"4px 8px", fontSize:12, color:"#e6f4ea"},
  section:{border:"1px dashed #363636",borderRadius:12,padding:10,marginTop:8},
  sectionLabel:{fontSize:12,color:"#cbd5e1",marginBottom:6},
  knobs:{display:"grid",gridTemplateColumns:"repeat(4,minmax(0,1fr))",gap:8},
  knob:{background:"rgba(255,255,255,0.03)",border:"1px solid #2a2a2a",borderRadius:10,padding:8},
  knobLabel:{fontSize:12, color:"#9aa0a6", marginBottom:4},
  knobVal:{fontSize:12, textAlign:"right", marginTop:4},
  kv:{display:"flex",justifyContent:"space-between",alignItems:"baseline",marginBottom:4}
};

